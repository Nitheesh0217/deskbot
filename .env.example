# DeskBot v5.2 — Supabase Edge Function secrets (set in Supabase → Edge Functions → Secrets).
# Never commit real values. Everything below is OPTIONAL; with none set the bot runs rules-only.

# Free-tier AI (advisory news-risk labels only; never opens or closes trades)
GROQ_API_KEY=            # https://console.groq.com/keys  (primary; free tier, no card)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_DAILY_CAP=300       # our own cap, far below the free-tier daily limit
GEMINI_API_KEY=          # https://aistudio.google.com/apikey  (fallback; free tier, no card)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_CAP=200

# News layer
NEWS_MODE=shadow         # off | shadow (record only) | gate (HIGH risk pauses NEW entries; exits never wait)
NEWS_EVERY_MIN=30        # 48 reads/day ≈ 48 AI calls/day max (+ ≤1 retry each)
NEWS_AI=on               # off = rules-only, zero AI calls

# Alerts
DESKBOT_NTFY_TOPIC=      # optional: phone push via ntfy.sh (pick a long random topic name)
# DESKBOT_CRON_SECRET is managed in Supabase Vault (deskbot_cron_secret); do not put it here.

# Required to permit NEW paper entries after the 5.6.1 integrity upgrade.
# SHA-256 binds engine version, book, and complete resolved configuration.
# Approve the reviewed backtest's configHash, not an unchecked live configuration.
# Missing/mismatching fingerprints pause entries; existing positions remain managed.
DESKBOT_BTC_CONFIG_HASH=
DESKBOT_GOLD_CONFIG_HASH=
